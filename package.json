{
	"name": "mdsync-monorepo",
	"version": "1.0.0",
	"description": "Monorepo for the MDSync Obsidian plugin and its companion services.",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.17.0",
	"scripts": {
		"build": "pnpm --filter mdsync run build",
		"dev": "pnpm --filter mdsync run dev",
		"test": "pnpm -r --if-present run test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "pnpm -r --if-present run typecheck && tsc -p tests",
		"version": "node version-bump.mjs",
		"obsidian": "node tools/obsidian.mjs",
		"e2e:hub": "jiti tests/e2e/hub.ts",
		"e2e:realtime": "pnpm build && jiti tests/e2e/realtime.ts",
		"e2e:live": "pnpm build && jiti tests/e2e/live.ts",
		"e2e:live-share": "pnpm build && jiti tests/e2e/live-share.ts",
		"e2e:live-into-share": "pnpm build && jiti tests/e2e/live-into-share.ts",
		"e2e:shares": "pnpm build && jiti tests/e2e/shares.ts",
		"e2e:invite": "pnpm build && jiti tests/e2e/invite.ts",
		"e2e:guest": "pnpm build && jiti tests/e2e/guest.ts",
		"e2e:people": "pnpm build && jiti tests/e2e/people.ts",
		"e2e:live-drawing": "pnpm build && jiti tests/e2e/live-drawing.ts",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@mdsync/protocol": "workspace:*",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"playwright-core": "^1.63.0",
		"tslib": "^2.8.1",
		"typescript": "6.0.3"
	}
}
