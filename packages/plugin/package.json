{
	"name": "mdsync",
	"version": "1.0.0",
	"description": "Encrypted vault sync for Obsidian over your own storage.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsc -noEmit && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -noEmit"
	},
	"dependencies": {
		"@codemirror/merge": "^6.12.2",
		"@mdsync/protocol": "workspace:*",
		"diff": "^9.0.0",
		"ignore": "^7.0.6",
		"lz-string": "^1.5.0",
		"obsidian": "1.13.1",
		"qrcode": "^1.5.4",
		"y-codemirror.next": "^0.3.6",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.32"
	},
	"devDependencies": {
		"@codemirror/commands": "^6.8.1",
		"@types/diff": "^7.0.2",
		"@types/node": "^22.20.1",
		"@types/qrcode": "^1.5.6",
		"esbuild": "^0.25.12",
		"mdsync-relay": "workspace:*",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"@codemirror/commands": "^6.8.1",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6"
	}
}
